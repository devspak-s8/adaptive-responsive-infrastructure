# Auth.js / GitHub OAuth (server-only unless noted)
GITHUB_ID=""
GITHUB_SECRET=""
AUTH_SECRET=""
AUTH_DEBUG="false"
NEXTAUTH_URL="http://localhost:3000"
VITE_API_ORIGIN="http://localhost:3001"
API_PUBLIC_ORIGIN="http://localhost:3001"

# Supabase-hosted PostgreSQL / Prisma (database only; not Supabase Auth)
# Supabase transaction pooler URL (port 6543). The API adds pgbouncer=true
# automatically; keep DIRECT_URL on the session/direct port for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Bachs billing (server-only)
BACHS_API_KEY="sk_live_..."
BACHS_API_BASE_URL="https://api.bachs.io"
BACHS_WEBHOOK_SECRET=""
BACHS_DEVELOPER_PRODUCT_ID="prod_..."
BACHS_AUTOPILOT_PRODUCT_ID="prod_..."

# Server-side Google Gemini layout analysis (never expose this key to the browser)
AI_PROVIDER="google"
GOOGLE_AI_API_KEY=""
GOOGLE_AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GOOGLE_AI_MODEL="gemini-2.5-flash"
