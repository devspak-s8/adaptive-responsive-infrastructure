generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  DEVELOPER
  AUTOPILOT
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id                  String         @id @default(cuid())
  // Auth.js creates the base user before its sign-in event runs. These fields
  // are populated from the verified GitHub profile during that event.
  githubId            String?        @unique
  githubLogin         String?
  name                String?
  email               String?
  avatarUrl           String?
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  accounts            Account[]
  sessions            Session[]
  subscription        Subscription?
  projects            Project[]
  usagePeriods        UsagePeriod[]
}

model Account {
  userId              String
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@id([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  bachsCustomerId      String?            @unique
  bachsSubscriptionId  String?            @unique
  bachsProductId       String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  productionUrl  String
  environment    String   @default("Production")
  monitoring     Boolean  @default(true)
  autofixEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId, createdAt])
}

model UsagePeriod {
  id                           String   @id @default(cuid())
  userId                       String
  periodStart                  DateTime
  periodEnd                    DateTime
  monitoredSessions            Int      @default(0)
  codeRecommendationsGenerated Int      @default(0)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, periodStart])
}

model ProcessedWebhookEvent {
  id             String   @id @default(cuid())
  providerEventId String   @unique
  processedAt    DateTime @default(now())
}

