generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
  runtime    = "workerd"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  DEVELOPER
  AUTOPILOT
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id                  String         @id @default(cuid())
  // Auth.js creates the base user before its sign-in event runs. These fields
  // are populated from the verified GitHub profile during that event.
  githubId            String?        @unique
  githubLogin         String?
  name                String?
  email               String?        @unique
  avatarUrl           String?
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  accounts            Account[]
  sessions            Session[]
  subscription        Subscription?
  projects            Project[]
  usagePeriods        UsagePeriod[]
}

model Account {
  userId              String
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@id([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 Plan               @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  bachsCustomerId      String?            @unique
  bachsSubscriptionId  String?            @unique
  bachsProductId       String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  productionUrl  String
  environment    String   @default("Production")
  monitoring     Boolean  @default(true)
  autofixEnabled Boolean  @default(false)
  automaticRollback Boolean @default(false)
  scanFrequency String   @default("continuous")
  notifyRegression Boolean @default(true)
  notifyCritical Boolean @default(true)
  notifyAutofix Boolean @default(false)
  protectionLevel String @default("safe")
  runtimeKey     String?  @unique
  // Replays of a console create request return the original project instead
  // of creating another row. The key is scoped with the owner ID.
  creationIdempotencyKey String? @unique
  lastHeartbeatAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  runtimeSessions RuntimeSession[]
  runtimeEvents   RuntimeEvent[]
  responsiveIssues ResponsiveIssueRecord[]
  runtimeAdaptations RuntimeAdaptation[]
  @@index([ownerId, createdAt])
}

model RuntimeSession {
  projectId  String
  sessionId  String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@id([projectId, sessionId])
  @@index([projectId, lastSeenAt])
}

model RuntimeEvent {
  id             String   @id @default(cuid())
  projectId      String
  sessionId      String
  type           String
  path           String?
  viewportWidth  Int?
  viewportHeight Int?
  metadata       Json?
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
}

model ResponsiveIssueRecord {
  id               String   @id @default(cuid())
  projectId        String
  fingerprint      String
  sessionId        String?
  title            String
  route            String?
  element          String?
  category         String   @default("overflow")
  severity         String   @default("Medium")
  confidence       Float?
  status           String   @default("Open")
  viewportWidth    Int?
  viewportHeight   Int?
  availableWidth   Int?
  cause            String?
  currentCss       String?
  recommendedFix   String?
  beforeVisualSnapshot String? @db.Text
  afterVisualSnapshot  String? @db.Text
  affectedViewports Json?
  occurrenceCount  Int      @default(1)
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @updatedAt
  metadata         Json?
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  adaptations      RuntimeAdaptation[]
  @@unique([projectId, fingerprint])
  @@index([projectId, status, lastSeenAt])
}

model RuntimeAdaptation {
  id             String  @id @default(cuid())
  projectId      String
  issueId        String?
  sessionId      String?
  route          String?
  viewportWidth  Int?
  viewportHeight Int?
  element        String?
  strategy       String
  css            Json?
  beforeVisualSnapshot String? @db.Text
  afterVisualSnapshot  String? @db.Text
  beforeQuality  Int?
  afterQuality   Int?
  verified       Boolean @default(false)
  rolledBack     Boolean @default(false)
  createdAt      DateTime @default(now())
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue          ResponsiveIssueRecord? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  @@index([projectId, createdAt])
  @@index([issueId, createdAt])
}

model UsagePeriod {
  id                           String   @id @default(cuid())
  userId                       String
  periodStart                  DateTime
  periodEnd                    DateTime
  monitoredSessions            Int      @default(0)
  codeRecommendationsGenerated Int      @default(0)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, periodStart])
}

model ProcessedWebhookEvent {
  id             String   @id @default(cuid())
  providerEventId String   @unique
  processedAt    DateTime @default(now())
}
