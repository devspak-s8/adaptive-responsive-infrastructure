{
  "name": "adaptive-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env.local tsx-entry.mjs",
    "start": "node tsx-entry.mjs",
    "prisma:generate": "node --env-file=../.env.local scripts/prisma-cli.mjs generate",
    "prisma:migrate": "node --env-file=../.env.local scripts/prisma-cli.mjs migrate deploy",
    "prisma:generate:production": "node scripts/prisma-cli.mjs generate",
    "prisma:migrate:production": "node scripts/prisma-cli.mjs migrate deploy"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
