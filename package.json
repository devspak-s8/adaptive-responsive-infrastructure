{
  "name": "adaptive-responsive-infrastructure",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --port=3000 --host=0.0.0.0",
    "build": "vite build --configLoader runner",
    "check:runtime": "tsc -p packages/adaptive-runtime/tsconfig.json",
    "build:runtime": "tsc -p packages/adaptive-runtime/tsconfig.build.json",
    "check:sdk": "tsc -p packages/adaptive-react/tsconfig.json",
    "build:sdk": "tsc -p packages/adaptive-react/tsconfig.build.json",
    "check:next": "tsc -p packages/adaptive-next/tsconfig.json",
    "build:next": "tsc -p packages/adaptive-next/tsconfig.build.json",
    "check:vue": "tsc -p packages/adaptive-vue/tsconfig.json",
    "build:vue": "tsc -p packages/adaptive-vue/tsconfig.build.json",
    "check:svelte": "tsc -p packages/adaptive-svelte/tsconfig.json",
    "build:svelte": "tsc -p packages/adaptive-svelte/tsconfig.build.json",
    "check:angular": "tsc -p packages/adaptive-angular/tsconfig.json",
    "build:angular": "tsc -p packages/adaptive-angular/tsconfig.build.json",
    "check:browser": "tsc -p packages/adaptive-browser/tsconfig.json",
    "build:browser": "tsc -p packages/adaptive-browser/tsconfig.build.json",
    "clean:adapters": "node scripts/clean-adapter-dists.mjs",
    "check:adapters": "npm.cmd run check:next && npm.cmd run check:vue && npm.cmd run check:svelte && npm.cmd run check:angular && npm.cmd run check:browser",
    "build:adapters": "npm.cmd run clean:adapters && npm.cmd run build:runtime && npm.cmd run build:sdk && npm.cmd run build:next && npm.cmd run build:vue && npm.cmd run build:svelte && npm.cmd run build:angular && npm.cmd run build:browser",
    "security:audit": "node scripts/security-audit.mjs",
    "cloudflare:build": "npm run build && npm --prefix server run prisma:generate:production",
    "cloudflare:dev": "npx wrangler dev",
    "cloudflare:deploy": "npx wrangler deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
